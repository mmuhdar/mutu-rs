# Contoh konfigurasi MutuRS. Salin menjadi .env lalu sesuaikan:  cp .env.example .env
# File .env dibaca oleh `docker compose` dan oleh `npm run dev`.

# Nama rumah sakit, tampil di kepala setiap halaman. Wajib untuk docker compose.
NAMA_RS="RSUD Contoh"

# Zona waktu RS. Menentukan bulan berjalan, jadi pergantian bulan mengikuti jam setempat.
# WIB: Asia/Jakarta, WITA: Asia/Makassar (bawaan bila dikosongkan), WIT: Asia/Jayapura.
APP_TIMEZONE=Asia/Makassar

# Admin Sistem awal, dibuat saat aplikasi mulai bila username ini belum ada. Wajib untuk docker compose.
# Restart tidak menimpa sandi yang sudah diganti lewat aplikasi; ganti sandi ini setelah masuk pertama kali.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-sandi-admin

# ---- docker compose (server RS) ----

# Kata sandi database PostgreSQL di dalam docker compose. Wajib; ganti dengan sandi yang kuat.
# Pakai huruf, angka, "-" atau "_" saja (sandi ini disusun ke dalam URL koneksi).
POSTGRES_PASSWORD=ganti-dengan-sandi-kuat

# Port di server RS tempat MutuRS dibuka: http://<ip-server>:<APP_PORT>
APP_PORT=3000

# ---- development (npm run dev, npm test) ----

# Koneksi PostgreSQL untuk development. docker compose tidak memakai nilai ini.
DATABASE_URL=postgres://mutu:mutu@127.0.0.1:55434/mutu
